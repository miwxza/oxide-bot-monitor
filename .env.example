DATABASE_URL=postgresql://oxide:oxide_dev@localhost:55432/oxide_monitor
BOT_SIMULATOR_URL=http://localhost:8788
PORT=3000

# token สำหรับ dev เท่านั้น — production ต้องตั้งค่าใหม่ (ห้ามใช้ค่าจริงใน source code)
ADMIN_TOKEN=dev-admin-token
AGENT_TOKEN=dev-agent-token
WEBHOOK_SECRET=dev-webhook-secret

# เวลา (วินาที) — ค่าเริ่มต้นสั้นสำหรับ demo
BOT_HEARTBEAT_TIMEOUT_S=15
ORDER_LEASE_S=30
PAYMENT_WINDOW_S=900
QUEUED_SLA_S=300
MAX_ATTEMPTS=3
RETRY_BASE_S=10
JOB_INTERVAL_MS=2000
SIMULATOR_POLL_MS=3000
